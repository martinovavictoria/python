import sys

def retry_on_exception(func):
    def wrapper(*args, **kwargs):
        try:
            return func(*args, **kwargs)
        except ValueError:
            # При ValueError просто повторяем вызов
            return None
        except OSError:
            # При OSError выводим сообщение и повторяем
            print(f"{func.__name__} raise OSError exception.", file=sys.stdout)
            return None
    
    return wrapper

@retry_on_exception
def read_file(filename):
    # Может вызвать OSError если файла нет
    with open(filename, 'r') as f:
        return f.read()


@retry_on_exception
def number(value):
    return int(value)

print(number("10"))
print(number("abc"))  #ValueError
print(read_file("abc.txt"))
